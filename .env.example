# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Required for db:migrate - find in Supabase Dashboard > Settings > API > service_role key
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Stripe API Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (from Stripe Dashboard)
STRIPE_PRICE_PRO_ID=price_...
STRIPE_PRICE_ENTERPRISE_ID=price_...

# Optional: Stripe Product IDs
STRIPE_PRODUCT_PRO_ID=prod_...
STRIPE_PRODUCT_ENTERPRISE_ID=prod_...

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_URL=http://localhost:3000

# Google Sheets (if using)
# For local development: use file path
GOOGLE_CREDENTIALS_PATH=/path/to/credentials.json
# For Vercel/production: use JSON content (copy entire JSON file content, minified)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_SHEETS_CUSTOMER_CONFIG_ID=spreadsheet_id
GOOGLE_SHEETS_ARTICLES_ID=spreadsheet_id

# Super Admin (Multi-tenant)
# The first user to sign up with this email becomes super admin
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# OpenAI API Key (for AI suggestions)
OPENAI_API_KEY=sk-...

# Alternative LLM API Keys (optional - configure in Admin Panel)
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=...
# GOOGLE_API_KEY=...
# COHERE_API_KEY=...
# TOGETHER_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
# FIREWORKS_API_KEY=...
# DEEPSEEK_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...

# Resend Email (for contact form)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Contact Form <contact@yourdomain.com>
CONTACT_EMAIL=support@yourdomain.com
